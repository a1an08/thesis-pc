<form class="form-horizontal">
    <div class="control-group">
        <label class="control-label" for="yolo_model_path">YOLO Model Path</label>
        <div class="controls">
            <input type="text" id="yolo_model_path" class="input-block-level" data-bind="value: settings.plugins.data_collector.yolo_model_path">
            <span class="help-block">Absolute path to your yolo model (e.g. /home/pi/models/best.pt)</span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label" for="xgb_model_path">XGBoost Model Path</label>
        <div class="controls">
            <input type="text" id="xgb_model_path" class="input-block-level" data-bind="value: settings.plugins.data_collector.xgb_model_path">
            <span class="help-block">Absolute path to your XGBoost model (e.g. /home/pi/models/xgb.joblib)</span>
        </div>
    </div>
</form>
