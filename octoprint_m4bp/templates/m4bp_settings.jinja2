<form class="form-horizontal">
    <div class="control-group">
        <label class="control-label" for="yolo_model_path">YOLO Model Path</label>
        <div class="controls">
            <input type="text" id="yolo_model_path" class="input-block-level" data-bind="value: settings.plugins.m4bp.yolo_model_path">
            <span class="help-block">Absolute path to your yolo model (e.g. /home/pi/models/best.pt)</span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label" for="catboost_model_path">CatBoost Model Path</label>
        <div class="controls">
            <input type="text" id="catboost_model_path" class="input-block-level" data-bind="value: settings.plugins.m4bp.catboost_model_path">
            <span class="help-block">Absolute path to your CatBoost model (e.g. /home/pi/models/model.cbm)</span>
        </div>
    </div>
</form>
