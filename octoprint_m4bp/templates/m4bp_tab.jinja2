<div class="data-collector-container">
    <div class="row-fluid">
        <div class="span12">
            <h2>Live AI Quality Prediction</h2>
            <div class="prediction-box">
                <h1 data-bind="text: currentPrediction, css: predictionClass">Waiting for model data...</h1>
            </div>
        </div>
    </div>
    
    <hr>
    
    <div class="row-fluid">
        <div class="span6">
            <h4>YOLO Confidence Scores</h4>
            <table class="table table-bordered">
                <thead><tr><th>Defect Type</th><th>Confidence</th></tr></thead>
                <tbody>
                    <tr><td>Over Extrusion</td><td data-bind="text: yolo_oextrusion().toFixed(2)"></td></tr>
                    <tr><td>Under Extrusion</td><td data-bind="text: yolo_uextrusion().toFixed(2)"></td></tr>
                    <tr><td>Stringing</td><td data-bind="text: yolo_stringing().toFixed(2)"></td></tr>
                    <tr><td>Spaghetti</td><td data-bind="text: yolo_spaghetti().toFixed(2)"></td></tr>
                </tbody>
            </table>
        </div>
        <div class="span6">
            <h4>Sensor Stats</h4>
            <table class="table table-bordered">
                <tbody>
                    <tr><td>Extruder Load Avg</td><td data-bind="text: load_avg() ? load_avg().toFixed(4) : '0.0000'"></td></tr>
                    <tr><td>Last Inference Ms</td><td data-bind="text: last_timestamp()"></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
